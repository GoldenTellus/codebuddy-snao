# ============================================================
# SNAO 1.0 部署配置
# 用法：cp .env.example .env   然后按下面注释把值填上
# 这个文件可以进仓库；.env 不行（已在 .gitignore 里）
# ============================================================

# ---------- 必填：先填这四个 ----------
# 数据库密码（自己定一个强密码，只在本机 PG 内部使用）
POSTGRES_PASSWORD=CHANGE_ME_强密码

# 会话签名密钥：随便生成一串 32 位以上随机字符
# 生成：openssl rand -hex 32
AUTH_SECRET=CHANGE_ME
# 密钥库加密密钥（用来加密存储第三方凭据）
# 生成：openssl rand -base64 32
KEY_VAULTS_SECRET=CHANGE_ME
# 网关服务令牌：岛与网关之间的内部凭据
# 生成：openssl rand -hex 24
GATEWAY_SERVICE_TOKEN=CHANGE_ME

# 线的管理员令牌：第一次可留空，`./snao bootstrap` 会自动生成并写回本文件
SNAO_ADMIN_TOKEN=

# 数据库在宿主机上的端口（本机 5432/15432 被占时改这里）
PG_HOST_PORT=15432

# docker 项目名：同一台机器跑第二套时改成别的名字，避免容器互相顶掉
COMPOSE_PROJECT_NAME=snao

# ---------- 岛 01（LobeHub）----------
LOBE_PORT=13210
LOBE_DB_NAME=lobechat
APP_URL=http://localhost:13210
INTERNAL_APP_URL=http://lobe:3210
AGENT_GATEWAY_PORT=8787
DEVICE_GATEWAY_PORT=8788
AGENT_GATEWAY_HOST_PORT=18787
DEVICE_GATEWAY_HOST_PORT=18788
AGENT_GATEWAY_URL=http://127.0.0.1:18787
DEVICE_GATEWAY_URL=http://127.0.0.1:18788

# 对象存储（岛 01 存文件用；只在内网，不对外发布端口）
RUSTFS_PORT=9000
RUSTFS_ADMIN_PORT=9001
RUSTFS_ACCESS_KEY=admin
RUSTFS_SECRET_KEY=CHANGE_ME_随机串
RUSTFS_LOBE_BUCKET=lobe

# ---------- 线 + 网关 + 岛 ----------
SNAO_TENANT=t1
SNAO_LINE_PORT=7001
SNAO_GATEWAY_PORT=7000
# 线到岛 01 的地址（岛换掉时只改这里，线一行不动）
SNAO_ISLAND_BASE=http://127.0.0.1:13210
# 线调用岛 02 / 岛 03 的内部口令
SNAO_LINE_SECRET=CHANGE_ME_随机串

# ---------- 岛 04（身份与组织）----------
SNAO_IDENTITY_PORT=7300

# ---------- 岛 03（接入：企业微信机器人）----------
# 不填也能跑，但收不到文件。去企微后台建「智能机器人」拿这两项。
WECOM_AIBOT_ID=
WECOM_AIBOT_SECRET=
WECOM_CONNECTION=long
# 自建应用（可选：只有要用微盘/文档 API 时才需要，且必须先配好备案域名+可信IP）
WECOM_CORP_ID=
WECOM_APP_AGENT_ID=
WECOM_APP_SECRET=

# ---------- 岛 02（沉淀）----------
SNAO_PRECIPITATE_PORT=7200
# 可进化参数（默认值即可；改动前先跑 node evolve/propose.mjs 在沙箱验证）
SNAO_DEDUP_THRESHOLD=0.8
SNAO_CONFLICT_ON=1
