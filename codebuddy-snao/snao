#!/usr/bin/env bash
# SNAO 1.0 一键运维
#
#   ./snao bootstrap   第一次：生成密钥、起岛 01、建库建表、发管理员令牌
#   ./snao up          起全部服务（岛 01 用 docker，其余用 node）
#   ./snao down        全停
#   ./snao status      看状态
#   ./snao logs <名>   看某个服务的日志
#   ./snao verify      跑验收（契约闸门 + 健康检查）
#   ./snao gate        只跑契约闸门
#   ./snao token       显示管理员令牌
#   ./snao accept      0.1 验收（一条命令证明跑通；加 --with-cognee 连引擎一起验）

set -uo pipefail
cd "$(dirname "$0")"

ENV_FILE="deploy/.env"
LOG_DIR="logs"
PID_DIR="$LOG_DIR/pids"
mkdir -p "$LOG_DIR" "$PID_DIR"

c_ok="\033[32m"; c_bad="\033[31m"; c_dim="\033[2m"; c_off="\033[0m"
say() { printf "%b%s%b\n" "$c_dim" "$*" "$c_off"; }
ok()  { printf "%b✓%b %s\n" "$c_ok" "$c_off" "$*"; }
bad() { printf "%b✗%b %s\n" "$c_bad" "$c_off" "$*"; }

need_env() {
  [ -f "$ENV_FILE" ] || { bad "缺少 $ENV_FILE —— 先执行：cp deploy/.env.example $ENV_FILE"; exit 1; }
}

# 把 .env 读进环境（逐行读；不用 `. <(grep ...)`，那个写法在某些 shell 下会静默读空）
source_env() {
  local line k v
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in ''|\#*) continue ;; esac
    case "$line" in *=*) ;; *) continue ;; esac
    k="${line%%=*}"; v="${line#*=}"
    case "$k" in *[!A-Z_]*) continue ;; esac
    export "$k=$v"
  done < "$ENV_FILE"
  [ -n "${PG_HOST_PORT:-}" ] && export PGPORT="$PG_HOST_PORT"
  export SNAO_TENANT="${SNAO_TENANT:-t1}"
}

env_get() { grep -E "^$1=" "$ENV_FILE" 2>/dev/null | tail -1 | cut -d= -f2-; }

SERVICES=(
  "line:./line/server.ts"
  "gateway:./gateway/server.ts"
  "island02:./islands/precipitate/server.ts"
  "island03:./islands/intake/server.ts"
  "island04:./islands/identity/server.ts"
)

# 端口在用的时候才取（source_env 之后），避免脚本加载时就被默认值钉死
port_of() {
  case "$1" in
    line)     echo "${SNAO_LINE_PORT:-7001}" ;;
    gateway)  echo "${SNAO_GATEWAY_PORT:-7000}" ;;
    island02) echo "${SNAO_PRECIPITATE_PORT:-7200}" ;;
    island03) echo "${SNAO_INTAKE_PORT:-7400}" ;;
    island04) echo "${SNAO_IDENTITY_PORT:-7300}" ;;
    embed)    echo "${EMBED_PORT:-7500}" ;;
  esac
}
path_of() { [ "$1" = gateway ] && echo /gw/health || echo /health; }

pid_alive() { [ -f "$PID_DIR/$1.pid" ] && kill -0 "$(cat "$PID_DIR/$1.pid")" 2>/dev/null; }

start_node() {
  local name="$1" entry="$2" port; port="$(port_of "$1")"
  if pid_alive "$name"; then say "  $name 已在运行"; return; fi
  node --import tsx "$entry" > "$LOG_DIR/$name.log" 2>&1 &
  echo $! > "$PID_DIR/$name.pid"
  say "  $name 启动中（:${port}）"
}

stop_node() {
  local pf="$PID_DIR/$1.pid"
  [ -f "$pf" ] || return
  kill "$(cat "$pf")" 2>/dev/null && say "  $1 停止"
  rm -f "$pf"
}

alive() { curl -sS -o /dev/null --max-time 3 "http://127.0.0.1:$1$2" 2>/dev/null; }

PY_SERVICES=("embed:./islands/embed/server.py:islands/precipitate/.venv/bin/python")

start_py() {
  local name="$1" entry="$2" py="$3" port; port="$(port_of "$1")"
  if pid_alive "$name"; then say "  $name 已在运行"; return; fi
  if [ ! -x "$py" ]; then bad "  $name 跳过（缺虚拟环境 ${py}）"; return; fi
  EMBED_PORT="$port" "$py" "$entry" > "$LOG_DIR/$name.log" 2>&1 &
  echo $! > "$PID_DIR/$name.pid"
  say "  $name 启动中（:${port}，本地向量）"
}

wait_pg() {
  local cname="${COMPOSE_PROJECT_NAME:-lobehub}-postgres" st=""
  for _ in $(seq 1 60); do
    st=$(docker inspect --format='{{.State.Health.Status}}' "$cname" 2>/dev/null)
    [ "$st" = "healthy" ] && { ok "数据库就绪"; return 0; }
    sleep 2
  done
  bad "数据库没起来（容器 $cname 状态：${st:-不存在}）"; return 1
}

case "${1:-status}" in
  bootstrap)
    need_env
    echo "== 1/6 检查依赖 =="
    command -v node   >/dev/null || { bad "没有 node"; exit 1; }
    command -v docker >/dev/null || { bad "没有 docker"; exit 1; }
    ok "node $(node -v) / $(docker -v | awk '{print $3}' | tr -d ,)"

    echo "== 2/6 补齐密钥 =="
    node scripts/gen-secrets.mjs || { bad "生成密钥失败"; exit 1; }
    source_env
    ok "密钥就绪"

    echo "== 3/6 起岛 01（docker）=="
    (cd deploy && docker compose up -d --remove-orphans 2>&1 | grep -E "Error|error" | head -3)
    wait_pg || exit 1

    echo "== 4/6 建库建表 =="
    node scripts/init-db.mjs || { bad "建库失败"; exit 1; }
    ok "库与表就绪"

    echo "== 5/6 等岛 01 起来 =="
    for _ in $(seq 1 60); do alive "${LOBE_PORT:-13210}" /api/v1/health && break; sleep 2; done
    ok "岛 01 就绪（:${LOBE_PORT:-13210}）"

    echo "== 6/6 完成 =="
    ok "管理员令牌：$(env_get SNAO_ADMIN_TOKEN)"
    say "  下一步：./snao up"
    ;;

  up)
    need_env; source_env
    (cd deploy && docker compose up -d --remove-orphans >/dev/null 2>&1)
    say "岛 01 已起（docker，项目 ${COMPOSE_PROJECT_NAME:-lobehub}）"
    echo "启动宿主服务："
    for s in "${SERVICES[@]}"; do start_node "${s%%:*}" "${s##*:}"; done
    for s in "${PY_SERVICES[@]}"; do
      IFS=':' read -r n e py <<< "$s"
      start_py "$n" "$e" "$py"
    done
    if [ -n "$(env_get WECOM_AIBOT_ID)" ]; then
      if pid_alive listener; then say "  listener 已在运行"; else
        node islands/intake/aibot-listener.mjs > "$LOG_DIR/listener.log" 2>&1 &
        echo $! > "$PID_DIR/listener.pid"
        say "  listener 启动中（企微长连接）"
      fi
    else
      say "  listener 跳过（未配置 WECOM_AIBOT_ID）"
    fi
    sleep 3
    echo "准备最小样例数据："
    node scripts/seed-fixtures.mjs 2>&1 | tail -8
    exec "$0" status
    ;;

  down)
    need_env; source_env
    for s in "${SERVICES[@]}"; do stop_node "${s%%:*}"; done
    for s in "${PY_SERVICES[@]}"; do stop_node "${s%%:*}"; done
    stop_node listener
    say "停止岛 01（docker）"
    (cd deploy && docker compose down >/dev/null 2>&1)
    ok "全部停止"
    ;;

  status)
    need_env; source_env
    echo "== 岛 01（docker · 项目 ${COMPOSE_PROJECT_NAME:-lobehub}）=="
    (cd deploy && docker compose ps --format '  {{.Service}}\t{{.Status}}' 2>/dev/null | head -6)
    echo "== 宿主服务 =="
    local_fail=0
    for s in "${SERVICES[@]}"; do
      name="${s%%:*}"; port="$(port_of "$name")"
      if alive "$port" "$(path_of "$name")"; then ok "$name :$port"; else bad "$name :$port 不通"; local_fail=1; fi
    done
    for s in "${PY_SERVICES[@]}"; do
      n="${s%%:*}"; p="$(port_of "$n")"
      if alive "$p" /health; then ok "$n :${p}（本地向量）"; else bad "$n :${p} 不通"; local_fail=1; fi
    done
    if pid_alive listener; then ok "listener（企微长连接）"; else say "listener 未运行"; fi
    exit "$local_fail"
    ;;

  logs) cat "$LOG_DIR/${2:-line}.log" 2>/dev/null | tail -40 || bad "没有 $2 的日志" ;;

  gate) need_env; source_env; node gate/run.mjs ;;

  accept) need_env; source_env; node scripts/acceptance.mjs "${@:2}" ;;

  verify)
    need_env; source_env
    echo "== 契约闸门 =="
    node gate/run.mjs || exit 1
    echo; echo "== 健康 =="
    exec "$0" status
    ;;

  token) env_get SNAO_ADMIN_TOKEN ;;

  *) sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
