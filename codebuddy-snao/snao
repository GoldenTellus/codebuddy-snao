#!/usr/bin/env bash
# SNAO 1.0 一键运维
#
#   ./snao bootstrap   第一次：生成密钥、建库、建表、发管理员令牌
#   ./snao up          起全部服务（岛 01 用 docker，其余用 node）
#   ./snao down        全停
#   ./snao status      看状态
#   ./snao logs <名>   看某个服务的日志
#   ./snao verify      跑验收（契约闸门 + 健康检查）
#   ./snao gate        只跑契约闸门
#   ./snao token       显示管理员令牌

set -uo pipefail
cd "$(dirname "$0")"

ENV_FILE="deploy/.env"
LOG_DIR="logs"
PID_DIR="$LOG_DIR/pids"
mkdir -p "$LOG_DIR" "$PID_DIR"

c_ok="\033[32m"; c_bad="\033[31m"; c_dim="\033[2m"; c_off="\033[0m"
say() { printf "%b%s%b\n" "$c_dim" "$*" "$c_off"; }
ok()  { printf "%b✓%b %s\n" "$c_ok" "$c_off" "$*"; }
bad() { printf "%b✗%b %s\n" "$c_bad" "$c_off" "$*"; }

need_env() {
  if [ ! -f "$ENV_FILE" ]; then
    bad "缺少 $ENV_FILE —— 先执行：cp deploy/.env.example $ENV_FILE"
    exit 1
  fi
}

env_get() { grep -E "^$1=" "$ENV_FILE" 2>/dev/null | tail -1 | cut -d= -f2-; }

# ---------- 服务清单（宿主侧跑的 node 服务）----------
SERVICES=(
  "line:./line/server.ts:${SNAO_LINE_PORT:-7001}"
  "gateway:./gateway/server.ts:${SNAO_GATEWAY_PORT:-7000}"
  "island02:./islands/precipitate/server.ts:${SNAO_PRECIPITATE_PORT:-7200}"
  "island03:./islands/intake/server.ts:${SNAO_INTAKE_PORT:-7400}"
  "island04:./islands/identity/server.ts:${SNAO_IDENTITY_PORT:-7300}"
)

start_node() {
  local name="$1" entry="$2" port="$3"
  if [ -f "$PID_DIR/$name.pid" ] && kill -0 "$(cat "$PID_DIR/$name.pid")" 2>/dev/null; then
    say "  $name 已在运行"
    return
  fi
  node --import tsx "$entry" > "$LOG_DIR/$name.log" 2>&1 &
  echo $! > "$PID_DIR/$name.pid"
  say "  $name 启动中（:${port}）"
}

stop_node() {
  local name="$1"
  local pf="$PID_DIR/$name.pid"
  [ -f "$pf" ] || return
  local pid; pid="$(cat "$pf")"
  kill "$pid" 2>/dev/null && say "  $name 停止"
  rm -f "$pf"
}

health() {
  curl -sS -o /dev/null --max-time 3 "http://127.0.0.1:$1$2" 2>/dev/null
}

case "${1:-status}" in
  bootstrap)
    need_env
    echo "== 1/5 检查依赖 =="
    command -v node >/dev/null || { bad "没有 node"; exit 1; }
    command -v docker >/dev/null || { bad "没有 docker"; exit 1; }
    ok "node $(node -v) / docker $(docker -v | awk '{print $3}' | tr -d ,)"

    echo "== 2/5 补齐密钥 =="
    python3 - "$ENV_FILE" <<'PY'
import re, secrets, sys, pathlib
p = pathlib.Path(sys.argv[1]); s = p.read_text(encoding='utf-8')
def gen(n, hexa=False):
    return secrets.token_hex(n) if hexa else secrets.token_urlsafe(n)
changed = []
for key, val, hexa in [
    ('AUTH_SECRET', gen(32, True), True),
    ('KEY_VAULTS_SECRET', gen(24), False),
    ('GATEWAY_SERVICE_TOKEN', gen(24, True), True),
    ('SNAO_LINE_SECRET', gen(18), False),
    ('SNAO_ADMIN_TOKEN', gen(24), False),
    ('RUSTFS_SECRET_KEY', gen(16), False),
]:
    pat = re.compile(rf'^{key}=.*$', re.M)
    cur = pat.search(s)
    if cur and re.search(r'CHANGE_ME|^$', cur.group(0).split('=',1)[1]):
        s = pat.sub(f'{key}={val}', s, count=1)
        changed.append(key)
p.write_text(s, encoding='utf-8')
print('  已生成:', ', '.join(changed) if changed else '（无需生成，值都已存在）')
PY
    ok "密钥就绪"

    echo "== 3/5 起岛 01（docker）=="
    (cd deploy && docker compose up -d --remove-orphans 2>&1 | tail -3)
    say "  等待岛 01 就绪…"
    for i in $(seq 1 60); do
      health "${LOBE_PORT:-13210}" /api/v1/health && break
      sleep 2
    done
    ok "岛 01 就绪（:${LOBE_PORT:-13210}）"

    echo "== 4/5 建库建表 =="
    node scripts/init-db.mjs || { bad "建库失败"; exit 1; }
    ok "库与表就绪"

    echo "== 5/5 完成 =="
    ok "管理员令牌：$(env_get SNAO_ADMIN_TOKEN)"
    say "  下一步：./snao up"
    ;;

  up)
    need_env
    (cd deploy && docker compose up -d --remove-orphans >/dev/null 2>&1)
    say "岛 01 已起（docker）"
    echo "启动宿主服务："
    for s in "${SERVICES[@]}"; do
      IFS=':' read -r name entry port <<< "$s"
      start_node "$name" "$entry" "$port"
    done
    # 企微采集器：有机器人凭据才起
    if [ -n "$(env_get WECOM_AIBOT_ID)" ]; then
      if [ -f "$PID_DIR/listener.pid" ] && kill -0 "$(cat "$PID_DIR/listener.pid")" 2>/dev/null; then
        say "  listener 已在运行"
      else
        node islands/intake/aibot-listener.mjs > "$LOG_DIR/listener.log" 2>&1 &
        echo $! > "$PID_DIR/listener.pid"
        say "  listener 启动中（企微长连接）"
      fi
    else
      say "  listener 跳过（未配置 WECOM_AIBOT_ID）"
    fi
    sleep 3
    exec "$0" status
    ;;

  down)
    for s in "${SERVICES[@]}"; do
      IFS=':' read -r name _ _ <<< "$s"
      stop_node "$name"
    done
    stop_node listener
    say "停止岛 01（docker）"
    (cd deploy && docker compose down >/dev/null 2>&1)
    ok "全部停止"
    ;;

  status)
    echo "== 岛 01（docker）=="
    (cd deploy && docker compose ps --format '  {{.Service}}\t{{.Status}}' 2>/dev/null | head -6)
    echo "== 宿主服务 =="
    for s in "${SERVICES[@]}"; do
      IFS=':' read -r name _ port <<< "$s"
      path=/health; [ "$name" = gateway ] && path=/gw/health
      if health "$port" "$path"; then ok "$name :$port"; else bad "$name :$port 不通"; fi
    done
    if [ -f "$PID_DIR/listener.pid" ] && kill -0 "$(cat "$PID_DIR/listener.pid")" 2>/dev/null; then
      ok "listener（企微长连接）"
    else
      say "listener 未运行"
    fi
    ;;

  logs)
    cat "$LOG_DIR/${2:-line}.log" 2>/dev/null | tail -40 || bad "没有 $2 的日志"
    ;;

  gate)
    node gate/run.mjs
    ;;

  verify)
    echo "== 契约闸门 =="
    node gate/run.mjs || exit 1
    echo
    echo "== 健康 =="
    exec "$0" status
    ;;

  token)
    env_get SNAO_ADMIN_TOKEN
    ;;

  *)
    sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'
    ;;
esac
